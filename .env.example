# 复制为 .env 后生效。不配置任何内容也能跑 —— 默认走离线 Mock Provider。

# ---------- LLM ----------
# mock = 离线规则模型(无需 Key, 完全确定性)；openai = 任何 OpenAI 兼容协议的服务
AGENTP_PROVIDER=mock

# DeepSeek:  AGENTP_MODEL=deepseek-chat        AGENTP_BASE_URL=https://api.deepseek.com/v1
# OpenAI:    AGENTP_MODEL=gpt-4o-mini          AGENTP_BASE_URL=https://api.openai.com/v1
# 通义千问:  AGENTP_MODEL=qwen-plus            AGENTP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地 Ollama: AGENTP_MODEL=qwen2.5            AGENTP_BASE_URL=http://localhost:11434/v1
AGENTP_MODEL=mock-medium
AGENTP_API_KEY=
AGENTP_BASE_URL=https://api.deepseek.com/v1
AGENTP_EMBEDDING_MODEL=text-embedding-3-small
AGENTP_TEMPERATURE=0.3
AGENTP_TIMEOUT=60
AGENTP_MAX_RETRIES=2

# ---------- 上下文预算 ----------
AGENTP_CTX_WINDOW=8192
AGENTP_RESERVE_OUTPUT=1024

# ---------- 循环护栏 ----------
# 这几个数字决定 Agent 会不会失控烧钱, 是最该按业务场景调的参数
AGENTP_MAX_STEPS=12
AGENTP_MAX_TOKENS=60000
AGENTP_MAX_COST=0.5
AGENTP_MAX_WALL=120
