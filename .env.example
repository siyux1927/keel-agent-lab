# 复制为 .env 后生效。不配置任何内容也能跑 —— 默认走离线 Mock Provider。

# ---------- LLM ----------
# mock = 离线规则模型(无需 Key, 完全确定性)；openai = 任何 OpenAI 兼容协议的服务
KEEL_PROVIDER=mock

# DeepSeek:  KEEL_MODEL=deepseek-chat        KEEL_BASE_URL=https://api.deepseek.com/v1
# OpenAI:    KEEL_MODEL=gpt-4o-mini          KEEL_BASE_URL=https://api.openai.com/v1
# 通义千问:  KEEL_MODEL=qwen-plus            KEEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地 Ollama: KEEL_MODEL=qwen2.5            KEEL_BASE_URL=http://localhost:11434/v1
KEEL_MODEL=mock-medium
KEEL_API_KEY=
KEEL_BASE_URL=https://api.deepseek.com/v1
KEEL_EMBEDDING_MODEL=text-embedding-3-small
KEEL_TEMPERATURE=0.3
KEEL_TIMEOUT=60
KEEL_MAX_RETRIES=2

# ---------- 上下文预算 ----------
KEEL_CTX_WINDOW=8192
KEEL_RESERVE_OUTPUT=1024

# ---------- 循环护栏 ----------
# 这几个数字决定 Agent 会不会失控烧钱, 是最该按业务场景调的参数
KEEL_MAX_STEPS=12
KEEL_MAX_TOKENS=60000
KEEL_MAX_COST=0.5
KEEL_MAX_WALL=120
